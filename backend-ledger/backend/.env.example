# Server Configuration
PORT=3000

# Database Connection
# Must be a replica set (or Atlas): transfers use multi-document transactions
MONGO_URI=mongodb://localhost:27017/banking_ledger?replicaSet=rs0

# Authentication
JWT_SECRET=your_jwt_secret_key_here

# Email Notification Service (Choose either SMTP or OAuth2)
# Option 1: Standard Gmail App Password
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password

# Option 2: Google OAuth2
CLIENT_ID=your_oauth_client_id
CLIENT_SECRET=your_oauth_client_secret
REFRESH_TOKEN=your_oauth_refresh_token

# System Admin (auto-created on server startup if missing)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_me_to_a_strong_password

# Public demo user (optional, enables "Explore with Demo Account" on the login page)
DEMO_EMAIL=demo@example.com
DEMO_PASSWORD=change_me_demo_password
